# ===========================
# AINCORE BLOCKCHAIN .gitignore
# ===========================

# Rust Build Artifacts
target/
build/
**/*.rs.bk

# Node.js
node_modules/
dist/
.next/

# System Files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Logs & Temp
*.log
logs/
tmp/

# ===========================
# 🔒 SECRETS — NEVER COMMIT
# ===========================
.env
.env.*
.env.local
.env.production
*.key
*.pem
*.p12
*.secret
*.keystore
wallet.key
node.key
node_identity.key
user.key
seed_phrase*
private_key*
# B307: a PQC spending seed and its default directory
*.seed
pqc_keys/
# B328: encrypted keystores (`aincore-cli keys`' directory, files named by
# their UUID with no extension; the bridges' JSON keystores)
keys/
*keystore*.json
key[0-9]*.json
vault_address.txt

# Node Data (RocksDB / Database)
data/
data_*/
.aincore/
aincore_data/
testnet_data/
*.db
*.sst
*.ldb

# gstack local artifacts (security reports stay local)
.gstack/
