.git
.github
.DS_Store

# Rust build output is recreated inside Docker. Sending it as context makes
# NAS builds painfully slow and can copy stale host artifacts into the image.
target
**/target

# Runtime data and secrets must never be baked into the image, nor sent as
# build context (`COPY . .`): data directories, keys and seeds, every .env
# (the tunnel key's, the bridge's, the contracts' deployer key), databases
# and logs, at any depth (B307: a pattern without `**/` matches the root
# only).
nas_data*
**/*_data
**/*_data_*
**/data
**/.env
**/.env.*
**/*.key
**/*.seed
**/pqc_keys
**/*.pem
**/*.p12
**/*.keystore
**/keys
**/*keystore*.json
**/key[0-9]*.json
**/*.secret
**/seed_phrase*
**/private_key*
**/*.db
**/*.sqlite
**/*.log

# Frontend/package-manager caches are not needed for the Rust node image.
node_modules
**/node_modules
build
dist
coverage

# Local/editor scratch.
*.tmp
*.bak
*.swp
